*.swp
*.swo
apps/web/tsconfig.tsbuildinfo

# The *private* release key must never be here. The public half
# (keys/release.pub) is committed on purpose and ships in every tarball.
*.pem
release.key

# Where an update parks the version it replaced, until the new one has proved
# it can migrate. Present only mid-update.
.rollback/

# The landing page's build output. `main.template.html` plus `mods/` are the
# sources; `assemble.mjs` splices them into Main.dc.html, and its own README
# says to edit the template rather than the result. Committing a generated file
# means it can drift from what generates it, which is how a page ships from
# sources nobody edited.
frontend/Main.dc.html
# Verification screenshots — 2.2 MB, regenerated by tools/shot.mjs on demand.
frontend/shots/
